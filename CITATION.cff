type: dataset
title: "Manṭiq al-ṭayr in TEI and IIIF: A Two-Manuscript Transcription Prototype (BnF Persan 348 and Smithsonian FSC-MS-28)"
version: 0.3.1
date-released: 2026-11-14
doi: "10.5281/zenodo.24202417"
repository-code: "https://github.com/KidoIshi/mantiq-al-tayr-tei-iiif"
url: "https://github.com/KidoIshi/mantiq-al-tayr-tei-iiif"
